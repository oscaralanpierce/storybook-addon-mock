{
    "name": "storybook-addon-mock",
    "version": "6.0.1",
    "description": "A storybook addon to mock fetch/XHR request",
    "keywords": [
        "storybook",
        "mock",
        "http-mock",
        "fetch-mock",
        "xhr-mock",
        "mock-data",
        "storybook-addon",
        "data-state",
        "storybook-mock-request",
        "mock-request"
    ],
    "author": "Farhad Yasir (nutboltu)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/nutboltu/storybook-addon-mock.git"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./preview": {
            "types": "./dist/preview.d.ts",
            "default": "./dist/preview.js"
        },
        "./preset": "./dist/preset.js",
        "./manager": "./dist/manager.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "README.md",
        "*.js",
        "*.d.ts"
    ],
    "scripts": {
        "clean": "rimraf ./dist",
        "prebuild": "yarn clean",
        "build": "tsup",
        "build:watch": "tsup --watch",
        "lint": "eslint .",
        "lint:fix": "yarn run lint --fix",
        "test": "jest src",
        "prerelease": "zx scripts/prepublish-checks.js",
        "release": "yarn build && auto shipit"
    },
    "dependencies": {
        "mock-xmlhttprequest": "^8.1.0",
        "path-to-regexp": "^6.3.0",
        "polished": "^4.2.2",
        "whatwg-fetch": "^3.6.19"
    },
    "devDependencies": {
        "auto": "^10.43.0",
        "boxen": "^8.0.1",
        "rimraf": "^3.0.2",
        "storybook": "^10.0.0",
        "ts-dedent": "^2.2.0",
        "ts-jest": "^29.4.0",
        "tsup": "^8.5.0",
        "typescript": "^4.9.4",
        "zx": "^8.7.1"
    },
    "peerDependencies": {
        "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
        "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
        "storybook": "^10.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/"
    },
    "bundler": {
        "managerEntries": [
            "src/manager.ts"
        ],
        "previewEntries": [
            "src/preview.ts",
            "src/index.ts"
        ],
        "nodeEntries": [
            "src/preset.ts"
        ]
    },
    "storybook": {
        "displayName": "Mock API Request",
        "supportedFrameworks": [
            "react",
            "vue"
        ],
        "icon": "https://raw.githubusercontent.com/nutboltu/storybook-addon-mock/master/assets/logo.svg"
    }
}
